# copy this file to .env and fill it

# Data layer: leave empty for local SQLite, or paste the Aiven PostgreSQL "Service URI"
DATABASE_URL=sqlite:///./finlog.db
# DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require

# Messaging layer: local docker Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Aiven Kafka (client certificate). Paste the full text of the 3 files.
# KAFKA_BOOTSTRAP_SERVERS=kafka-xxxx.aivencloud.com:12345
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KAFKA_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KAFKA_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# or Aiven Kafka with SASL (if you turn SASL on in the Aiven console)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=...
# KAFKA_CA_CERT="..."
